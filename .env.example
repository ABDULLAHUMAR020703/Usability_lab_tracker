# Consumer Insights Hub - runtime configuration (copy to .env). Paths may be absolute or relative to this folder.
PORT=4000
# 127.0.0.1 = only this laptop can open the app. Do not change unless you understand the security implications (there is no login in v1).
HOST=127.0.0.1

# Where the SQLite database lives
DATA_DIR=./data
# Where uploaded documents, NDA templates and signed NDAs live
STORAGE_DIR=./storage
# Where backups are written. Use an encrypted external drive for real protection, e.g. E:\CIH-Backups
BACKUP_DIR=./backups

# Max size of one uploaded research file (MB)
MAX_UPLOAD_MB=100

# Optional: full path to LibreOffice's soffice if installed in a custom location (DOCX -> PDF conversion)
# SOFFICE_PATH=
